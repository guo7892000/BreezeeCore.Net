<?xml version="1.0" encoding="utf-8"?>
<!--通常在开发过程中，我们都会将每个对象固化为一个脚本，那样方便修改；或者每次提交的数据库变更申请脚本，将其放到以提交日期命名的目录中。
但最终发布执行时，我们又希望能合在一起执行，本功能就是为了解决这个问题。
如果同一个目录下脚本有执行先后顺序，文件名请按升序方式命名好，保证先执行的文件名排在前面。
支持多个目录的文件合并到同一个目标文件中，即会目标文件会追加内容。-->
<!--configuration：根节点-->
<!--targetPath：生成目录，非必填。如果为空，那么会在配置文件所在目录下创建子目录【900_FinalScript】，作为生成目录-->
<!--dbType：数据库类型，包括SqlServer、Oracle、MySql、SQLite、PostgreSql。非必填-->
<!--sourcePath：源目录，非必填。为空或输入的目录找不到时，会以选择的本配置文件所在的目录为查找的源目录-->
<configuration targetPath="D:\javaAuto\11" dbType="SqlServer" sourcePath="D:\javaAuto\03_SqlServer\001_DBObjects" >
  <!--class：分类，每个class分类节点都会生成一个文件，该节点必需。-->
  <!--finalName：输出文件名，必填-->
  <!--sourcePathAbs：读取的绝对路径（优先），非必填-->
  <!--sourcePathRel：读取的相对目录（非优先），但如文件都在同一个父目录下，就只填写相对目录即可。-->
  <!--fileExt：文件扩展名（支持逗号分隔多个），非必填。-->
  <!--remark：说明，仅用于描述本合并脚本的内容，非必填。-->
  <!--item：只提取上述目录（包含所有子目录）内的部分文件名，非必填。-->
	
  <!--创建表-->
  <class finalName="01_table_all.sql" sourcePathRel="\01_Table" sourcePathAbs="" fileExt="" remark="创建表">
    <item></item>
  </class>

  <!--创建函数-->
  <class finalName="02_function_all.sql" sourcePathRel="03_Function" fileExt="" remark="创建函数">
    <item>F_COMMON_GET_PY.sql</item>
    <item>F_COMMON_GET_SPLIT_STRING.sql</item>
    <item>F_SYS_GET_WORD_SEQUENCE_NO.sql</item>
  </class>

  <!--创建视图-->
  <class finalName="03_view_all.sql" sourcePathRel="04_View" fileExt="" remark="创建视图">
    <item>V_COM_PROVICE_CITY.sql</item>
    <item>V_ORG_INFO.sql</item>
    <item>V_SYS_AND_MENU.sql</item>
  </class>

  <!--创建视图-->
  <class finalName="03_view_all.sql" sourcePathRel="05_View" fileExt="" remark="创建视图">
    <item>V_SYS_MENU_FULL_PATH.sql</item>
    <item>V_SYS_RECEIVER_GROUP_USER_EMP.sql</item>
    <item>V_SYS_MENU_BUTTON.sql</item>
    <item>V_SYS_MENU_COMMON_BUTTON.sql</item>
    <item>V_USER_MENU.sql</item>
    <item>V_USER_MENU_BUTTON.sql</item>
  </class>

  <!--创建存储过程-->
  <class finalName="04_produce_all.sql" sourcePathAbs="D:\javaAuto\04_Produce" remark="创建存储过程">
  </class>

  <!--初始化数据-->
  <class finalName="05_data_all.sql" sourcePathAbs="05_Data" remark="初始化数据">
    <item></item>
  </class>

</configuration>