<?xml version="1.0" encoding="utf-8"?>
<!--【点击复制字符】配置
【字符转义】：包括：
	&lt;	<	小于号 
	&gt;	>	大于号 
	&amp;	&	和
	&apos;	'	单引号
	&quot	"	双引号 
【内置参数】：目前只有内置日期参数（不区分大小写），包括：yyyyMMdd、yyyy-MM-dd、yyyy-MM、yyyyMM、yyyyMMddHHmiss、yyyyMMddHHmi、yyyy。
【strings】：根节点；属性包括：max：group的默认每行项目数；子节点包括：params、global、tap。
【tap】：页签，为2级节点；属性包括：name：页签名称。子节点包括：group。
【params】：全局参数集合，为2级节点，无属性；子节点包括：param。
【param】：参数，为3级节点；属性包括：key：键，不区分大小写、value：值、remark：备注。用于string节点中text属性引用（格式：#key#）。
【global】：全局组，为2级节点，无属性，子节点包括：group。建议最多配置1至2个group子节点。
【group】：分组，为3级节点，子节点包括：string。属性包括：
	text：组名。没选中【流式布局】时，才显示。
	fontColor：组名的颜色，默认黑色。没选中【流式布局】时，才显示。
	max：确定本分组的每行项目数，当不指定时则取根节点配置的max属性。
	itemFontColor：组内子项显示的标签颜色，默认黑色。
【string】：复制项，为4级节点。无子节点；其属性包括：
	type：text文本，用于复制字符的；path路径，可复制或打开；file是文件，可读取文件内容来复制，当文件不存在时会显示黄色。
	ctrol：TextBox是一般文本框；RichTextBox是富文件框，针对type为file的配置。
	label：标签，显示的复制项名称。
	text：实际拷贝的内容。支持全局配置参数、内置参数的字符替换，如【#yyyyMMdd#】表示替换为当前日期字符，适用场景如当天备份目录名。如果要输出实际的#，请使用{{@JH@}}代替。
	needEncrypt：是否需要加密：0-否，1-是
	hadEncrypt：是否已加密：0-否，1-是。当需要加密时，这里改为0，并且【text】属性要改为明文，在加载XML文件时，会自动加密并保存文件。	
	pwdchar：设置密码掩码字符，如复制的是密码，请设置其值为*。
	tip：按钮的提示信息。
	pathAbs：读取文本文件的绝对路径，针对type为file的配置。
	pathRel：读取文本文件的相对当前选择的配置文件所在目录的路径，针对type为file的配置。
	fontColor：标签的颜色，默认黑色，支持颜色名称、16进制、RPG三种表示方式。-->
<strings max="5">
	<params>
		<param key="bakDir" value="C:\appWeb\test\bak" remark=""/>
		<param key="test01" value="测试01" remark=""/>
	</params>
	<global>
		<group text="示例_全局1" fontColor="green"  itemFontColor="blue">
			<string type="file" ctrol="RichTextBox" label="绝对路径富文件" pathAbs="C:\Windows\System32\drivers\etc\protocol" tip="" pwdchar=""/>
			<string type="file" ctrol="RichTextBox" label="相对路径富文件" pathRel="DataTemplate\DBTool\AutoFile\I.txt" tip="" pwdchar=""/>
		</group>
		<group text="示例_全局2" fontColor="green"  itemFontColor="blue">
			<string type="file" ctrol="RichTextBox" label="绝对路径富文件" pathAbs="C:\Windows\System32\drivers\etc\protocol" tip="" pwdchar=""/>
			<string type="file" ctrol="RichTextBox" label="相对路径富文件" pathRel="DataTemplate\DBTool\AutoFile\I.txt" tip="" pwdchar=""/>
		</group>
	</global>
	<tap name="测试1">
		<group text="示例_分组1" max="5" fontColor="255,87,51" itemFontColor="dark">
			<string type="text" ctrol="TextBox" label="参数测试" text="这是#test01#" tip="" pwdchar=""/>
			<string type="text" ctrol="TextBox" label="文本示例" text="文本2021" tip="这是文本示例" pwdchar="" fontColor="255,87,51"/>
			<string type="text" ctrol="TextBox" label="明文密码示例" text="1122" tip="" pwdchar="*" fontColor="blue"/>
			<string type="text" ctrol="TextBox" label="加密密码示例" text="1122" tip="设置needEncrypt=1，hadEncrypt=0，加载文件中会自动加密保存" fontColor="blue" needEncrypt="1" hadEncrypt="0"/>
			<string type="text" ctrol="TextBox" label="加密含#示例" text="含{{@JH@}}号加密测试" tip="加密含#示例" pwdchar="*" fontColor="blue" needEncrypt="1" hadEncrypt="0"/>
			<string type="text" ctrol="TextBox" label="已加密示例" text="iYSDxlKQa+djsCE8sjHaIA==" tip="密码" needEncrypt="1" hadEncrypt="1"/>
			<string type="path" ctrol="TextBox" label="路径示例" text="C:\Windows" tip="" pwdchar="" fontColor="#27C53"/>
			<string type="path" ctrol="TextBox" label="目录示例" text="D:\" tip="" pwdchar=""/>
			<string type="text" ctrol="TextBox" label="版权" text="@2021" tip="" pwdchar=""/>
			<string type="text" ctrol="TextBox" label="注释" text="这是{{@JH@}}注释" tip="" pwdchar=""/>
			<string type="text" ctrol="TextBox" label="当天备份目录" text="#bakDir#\#YYYYMMdd#" tip="" pwdchar=""/>
			<string type="text" ctrol="TextBox" label="当天时分秒备份目录" text="#bakDir#\#YYYYMMddhhmiSS#" tip="" pwdchar=""/>
			<string type="text" ctrol="TextBox" label="当天时分备份目录" text="#bakDir#\#YYYYMMddhhmi#" tip="" pwdchar=""/>
		</group>
		<group text="示例_分组2" fontColor="green"  itemFontColor="blue">
			<string type="file" ctrol="RichTextBox" label="绝对路径富文件" pathAbs="C:\Windows\System32\drivers\etc\protocol" tip="" pwdchar=""/>
			<string type="file" ctrol="RichTextBox" label="相对路径富文件" pathRel="DataTemplate\DBTool\AutoFile\I.txt" tip="" pwdchar=""/>
			<!--默认按钮事件是复制字符，但我们可以将该按钮事件绑定到其他按钮事件中，如下面的得到自1970-1-1以来的毫秒数-->
			<string type="text" ctrol="TextBox" label="自1970-1-1以来的毫秒数" text="" tip="绑定当前类的其他点击事件到当前按钮（作用不大）" method="GetMillisecond_Click"/>
		</group>
	</tap>
	<tap id="test02" name="测试2" color="red">
		<group text="示例2_分组1" max="5" fontColor="255,87,51" itemFontColor="dark">
			<string type="text" ctrol="TextBox" label="文本示例211" text="文本2021" tip="这是文本示例" pwdchar="" fontColor="255,87,51"/>
			<string type="text" ctrol="TextBox" label="密码示例212" text="1122" tip="" pwdchar="*" fontColor="blue"/>
		</group>
		<group text="示例2_分组1" max="5" fontColor="255,87,51" itemFontColor="dark">
			<string type="text" ctrol="TextBox" label="文本示例221" text="文本2021" tip="这是文本示例" pwdchar="" fontColor="255,87,51"/>
			<string type="text" ctrol="TextBox" label="密码示例222" text="1122" tip="" pwdchar="*" fontColor="blue"/>
		</group>
	</tap>
</strings>